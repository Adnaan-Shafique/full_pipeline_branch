# Three-mode field-ops demo UI (frontend/demo_dash_modes.py), port 7872.
#
# REFERENCE COPY. Do not hand-edit and install this - the checkout path appears
# in five places below, and a unit with one of them wrong fails with a bare
# 203/EXEC that names none of them. Generate the real unit instead, which takes
# every path from the checkout it is run in:
#
#     ./deploy/make_unit.sh modes    | sudo tee /etc/systemd/system/<name>.service
#
# The paths below are the field-ops VM's own layout, kept so this file reads as
# a finished example of what the script produces.

[Unit]
Description=Field Ops demo - three pipeline modes (Dash, port 7872)
Documentation=file:///data/adnaan/field_ops/integrated_pipeline/MODES.md
# network-online, not just network: the app contacts the LLM proxy while
# building its status line, and "network" alone is satisfied before an address
# is actually configured.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ADMIN
Group=ADMIN
WorkingDirectory=/data/adnaan/field_ops/integrated_pipeline

# The API key lives here, not in this file: a unit file is world-readable by
# design, and `systemctl cat` prints it to anyone who asks. Keep the env file
# at chmod 600. The leading '-' means the service still starts if it is
# absent - useful when the proxy runs with auth disabled.
EnvironmentFile=-/etc/fieldops-demo.env

# Unbuffered, or journalctl shows nothing until Python flushes - which during
# a slow pipeline run can be minutes.
Environment=PYTHONUNBUFFERED=1
Environment=DASH_HOST=0.0.0.0
Environment=DASH_PORT=7872

ExecStart=/data/adnaan/field_ops/integrated_pipeline/venv_yolox/bin/python \
          /data/adnaan/field_ops/integrated_pipeline/frontend/demo_dash_modes.py

Restart=always
RestartSec=5
# A run holds the worker for seconds per photograph; give it room to finish
# rather than killing it mid-batch on stop.
TimeoutStopSec=30
KillSignal=SIGINT

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fieldops-demo-modes

[Install]
WantedBy=multi-user.target
