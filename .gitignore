__pycache__/
*.pyc
.venv/
venv/
venv_*/
demo_venv/

# Per-run outputs
demo_runs/
batch_runs/

# Model weights: u2netp.onnx is deliberately committed (see models/README.md) so
# the demo never depends on a first-run download. Everything else stays out.
models/*.onnx
!models/u2netp.onnx

# The PP-OCRv6 ONNX files, committed for the same reason and with more force:
# RapidOCR's response to a missing model file is to DOWNLOAD one, so on an
# offline demo host an absent file is a hang rather than an error. These are the
# same files handed to the Android team, so what the demo reads is what the edge
# device reads. ~6 MB for the pair. See models/ocr/README.md.
!models/ocr/
!models/ocr/*.onnx

# The YOLOX checkpoint - ~70MB, copied from AISERVER per COPY_FROM_AISERVER.md,
# not source. Note this pattern is anchored with a leading slash: an unanchored
# "models/" is what silently swallowed src/YOLOX/yolox/models in the field-ops
# repo, and app/vendor/yolox/models must stay tracked.
/models/*.pth

# Mode 3's tuned system prompts. Per-machine demo tuning, written by the UI -
# the built-in prompts live in app/pipeline/questions.py, and the repo default
# is the ABSENCE of this file (see MODES.md). Committing one machine's wording
# would silently change what every other machine sends to the model.
/config/prompts.yaml

# A filled-in service environment file holds the proxy API key. Only the
# .example template is tracked; see SERVICE.md.
fieldops-demo.env
deploy/fieldops-demo.env
